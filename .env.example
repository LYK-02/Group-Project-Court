# ==============================================================================
# Group Project Court — Environment Configuration
# Copy this file to .env and adjust variables as needed for local development.
# NEVER commit .env to source control or use development secrets in production.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# Client Origin (CORS & Session Cookie Binding)
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/group_project_court

# Test Database Connection (Isolated from development/production)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/group_project_court_test

# Session Secret (Must be >= 32 characters in production)
SESSION_SECRET=dev-session-secret-must-be-replaced-with-secure-random-token-in-prod

# Rate Limiting (Requests per 15 minutes window)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
