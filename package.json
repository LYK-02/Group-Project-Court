{
  "name": "group-project-court",
  "version": "1.0.0",
  "private": true,
  "description": "Group Project Court — A satirical full-stack student-team collaboration app.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "test:all": "npm --prefix server test && npm --prefix client test",
    "lint": "npm --prefix server run lint && npm --prefix client run lint",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "dotenv": "^18.0.8",
    "pg": "^8.23.1"
  }
}
